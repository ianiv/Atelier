#!/bin/bash
# Formats the Swift files being committed with SwiftFormat (.swiftformat at the repo root).
# A file that also has unstaged changes is only checked, so the commit can't pick up those
# changes; format it with `swiftformat <file>` and stage it again.
# Installed by Scripts/install-hooks.sh. Skip once with `git commit --no-verify`.

if ! command -v swiftformat >/dev/null 2>&1; then
  echo "pre-commit: swiftformat not found (brew install swiftformat); not formatting" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
while IFS= read -r -d '' file; do
  if git diff --quiet -- "$file"; then
    swiftformat --quiet "$file" && git add -- "$file"
  elif ! swiftformat --quiet --lint "$file" 2>/dev/null; then
    echo "pre-commit: $file needs formatting; run swiftformat \"$file\" and stage it again" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
exit $status
