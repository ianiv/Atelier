<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac builds only: Sparkle's update feed, written by Scripts/release.sh and attached to each
	     GitHub Release, and the public half of the key that signs updates. -->
	<key>SUFeedURL</key>
	<string>https://github.com/ianiv/Atelier/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>ezs3okxIgkPwyf+GLRNCaOaessELrI8UCduF6yp43wo=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Atelier pairing link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>atelier-pair</string>
			</array>
		</dict>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save to Photos adds your generated images to your photo library.</string>
	<!-- The Edit screen's .cube LUTs (UTType.cubeLUT): imported, since Atelier doesn't own the
	     format, under the identifier DaVinci Resolve exports, so Save panels name files .cube. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.blackmagicdesign.cube</string>
			<key>UTTypeDescription</key>
			<string>3D LUT</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.text</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cube</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
