// Signing for the Atelier app target.
//
// By default the app is signed to run locally, so it builds without an Apple developer account.
// To sign with your own team, create Config/Local.xcconfig (it is not committed) containing:
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team ID>

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// SwiftUI's VideoPlayer (the clip player) needs AVKit itself, which Swift doesn't link for it.
OTHER_LDFLAGS = $(inherited) -framework AVKit

#include? "Local.xcconfig"
